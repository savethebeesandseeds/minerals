{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waajacu.org/schemas/values/crystallography-structure-reference-v1.schema.json",
  "title": "Crystallography structure references v1",
  "description": "Repeatable citations that a reviewed source record carries in support of a structure observation. Citation roles are explicit and are never upgraded from a generic source-record citation without evidence.",
  "type": "array",
  "minItems": 1,
  "maxItems": 128,
  "items": {
    "$ref": "#/$defs/reference"
  },
  "$defs": {
    "nonPlaceholderText": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          ".",
          "?",
          "N/A",
          "n/a",
          "unknown"
        ]
      }
    },
    "doi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "normalized"
      ],
      "properties": {
        "raw": {
          "allOf": [
            {
              "$ref": "#/$defs/nonPlaceholderText"
            },
            {
              "maxLength": 500
            }
          ]
        },
        "normalized": {
          "type": "string",
          "minLength": 7,
          "maxLength": 500,
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/nonPlaceholderText"
              },
              {
                "maxLength": 300
              }
            ]
          }
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/nonPlaceholderText"
            },
            {
              "maxLength": 2000
            }
          ]
        },
        "container_title": {
          "allOf": [
            {
              "$ref": "#/$defs/nonPlaceholderText"
            },
            {
              "maxLength": 500
            }
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 1600,
          "maximum": 9999
        },
        "volume": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "issue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "first_page": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "last_page": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "article_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "doi": {
          "$ref": "#/$defs/doi"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "publication_status",
        "citation"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_structure_record_citation",
              "primary_structure_determination",
              "structure_refinement",
              "structure_reanalysis"
            ]
          }
        },
        "publication_status": {
          "enum": [
            "published",
            "prepublication",
            "personal_communication",
            "unpublished",
            "unknown"
          ]
        },
        "citation": {
          "$ref": "#/$defs/citation"
        },
        "source_citation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "citation_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publication_status": {
                "const": "published"
              }
            },
            "required": [
              "publication_status"
            ]
          },
          "then": {
            "properties": {
              "citation": {
                "anyOf": [
                  {
                    "required": [
                      "doi"
                    ]
                  },
                  {
                    "required": [
                      "authors",
                      "container_title",
                      "year"
                    ]
                  },
                  {
                    "required": [
                      "title",
                      "container_title",
                      "year"
                    ]
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "citation": {
                "anyOf": [
                  {
                    "required": [
                      "doi"
                    ]
                  },
                  {
                    "required": [
                      "authors"
                    ]
                  },
                  {
                    "required": [
                      "title"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
