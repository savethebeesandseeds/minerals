{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waajacu.org/schemas/values/crystallography-unit-cell-v1.schema.json",
  "title": "Crystallography unit-cell observations v1",
  "description": "Repeatable complete six-parameter, source-reported unit cells. Values preserve the source token, standard uncertainty, source field, formula context, and reported experimental conditions.",
  "type": "array",
  "minItems": 1,
  "maxItems": 32,
  "items": {
    "$ref": "#/$defs/unitCell"
  },
  "$defs": {
    "sourceField": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160,
      "pattern": "^_[A-Za-z0-9_.-]+$"
    },
    "rawToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "not": {
        "enum": [
          ".",
          "?",
          "N/A",
          "n/a",
          "unknown"
        ]
      }
    },
    "length": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "raw_lexeme",
        "unit",
        "source_field"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "standard_uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "uncertainty_source": {
          "enum": [
            "appended_lexeme",
            "separate_source_field"
          ]
        },
        "raw_lexeme": {
          "$ref": "#/$defs/rawToken"
        },
        "unit": {
          "const": "angstrom"
        },
        "source_field": {
          "$ref": "#/$defs/sourceField"
        }
      }
    },
    "angle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "raw_lexeme",
        "unit",
        "source_field"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "standard_uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "uncertainty_source": {
          "enum": [
            "appended_lexeme",
            "separate_source_field"
          ]
        },
        "raw_lexeme": {
          "$ref": "#/$defs/rawToken"
        },
        "unit": {
          "const": "degree"
        },
        "source_field": {
          "$ref": "#/$defs/sourceField"
        }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "raw_lexeme",
        "unit",
        "source_field",
        "origin"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "standard_uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "uncertainty_source": {
          "enum": [
            "appended_lexeme",
            "separate_source_field"
          ]
        },
        "raw_lexeme": {
          "$ref": "#/$defs/rawToken"
        },
        "unit": {
          "const": "angstrom^3"
        },
        "source_field": {
          "$ref": "#/$defs/sourceField"
        },
        "origin": {
          "enum": [
            "reported_in_source",
            "source_curated"
          ]
        }
      }
    },
    "formulaContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "source_field"
      ],
      "properties": {
        "raw": {
          "$ref": "#/$defs/rawToken"
        },
        "source_field": {
          "$ref": "#/$defs/sourceField"
        }
      }
    },
    "formulaUnitsZ": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "raw_lexeme",
        "source_field",
        "formula_context"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "raw_lexeme": {
          "$ref": "#/$defs/rawToken"
        },
        "source_field": {
          "$ref": "#/$defs/sourceField"
        },
        "formula_context": {
          "$ref": "#/$defs/formulaContext"
        }
      }
    },
    "temperatureMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "raw_lexeme",
        "unit",
        "source_field"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "standard_uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "raw_lexeme": {
          "$ref": "#/$defs/rawToken"
        },
        "unit": {
          "const": "K"
        },
        "source_field": {
          "$ref": "#/$defs/sourceField"
        }
      }
    },
    "pressureMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "raw_lexeme",
        "unit",
        "source_field"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "standard_uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "raw_lexeme": {
          "$ref": "#/$defs/rawToken"
        },
        "unit": {
          "const": "kPa"
        },
        "source_field": {
          "$ref": "#/$defs/sourceField"
        }
      }
    },
    "temperatureCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "measurement"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cell_measurement",
            "diffraction_ambient"
          ]
        },
        "measurement": {
          "$ref": "#/$defs/temperatureMeasurement"
        }
      }
    },
    "pressureCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "measurement"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cell_measurement",
            "diffraction_ambient"
          ]
        },
        "measurement": {
          "$ref": "#/$defs/pressureMeasurement"
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "temperatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/temperatureCondition"
          }
        },
        "pressures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/pressureCondition"
          }
        },
        "thermal_history_raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "pressure_history_raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "determinationMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "raw"
      ],
      "properties": {
        "kind": {
          "enum": [
            "single_crystal_x_ray_diffraction",
            "powder_x_ray_diffraction",
            "neutron_diffraction",
            "electron_diffraction",
            "other",
            "unknown"
          ]
        },
        "raw": {
          "$ref": "#/$defs/rawToken"
        },
        "source_field": {
          "$ref": "#/$defs/sourceField"
        }
      }
    },
    "radiation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "probe": {
          "enum": [
            "x_ray",
            "neutron",
            "electron",
            "other"
          ]
        },
        "wavelength_angstrom": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wavelength_standard_uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "unitCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a",
        "b",
        "c",
        "alpha",
        "beta",
        "gamma"
      ],
      "properties": {
        "a": {
          "$ref": "#/$defs/length"
        },
        "b": {
          "$ref": "#/$defs/length"
        },
        "c": {
          "$ref": "#/$defs/length"
        },
        "alpha": {
          "$ref": "#/$defs/angle"
        },
        "beta": {
          "$ref": "#/$defs/angle"
        },
        "gamma": {
          "$ref": "#/$defs/angle"
        },
        "volume": {
          "$ref": "#/$defs/volume"
        },
        "formula_units_z": {
          "$ref": "#/$defs/formulaUnitsZ"
        },
        "determination_method": {
          "$ref": "#/$defs/determinationMethod"
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        },
        "radiation": {
          "$ref": "#/$defs/radiation"
        }
      }
    }
  }
}
