{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waajacu.org/schemas/pilots/cod-metadata-discovery-query-plan-v1.schema.json",
  "title": "Deterministic COD metadata discovery query plan v1",
  "description": "A frozen, metadata-only partition of the COD seven-digit identifier space into 1,000 ordered DDD-prefix GET requests. The plan fixes transport and resource limits before retrieval; it does not contain normalized mineral claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "pilot_id",
    "plan_revision",
    "status",
    "endpoint",
    "request_digest_policy",
    "response_validation",
    "transport",
    "limits",
    "requests",
    "safety_assertions"
  ],
  "properties": {
    "format": {
      "const": "waajacu-cod-metadata-discovery-query-plan"
    },
    "schema_version": {
      "const": 1
    },
    "pilot_id": {
      "const": "cod-crystallography-v1"
    },
    "plan_revision": {
      "const": 1
    },
    "status": {
      "const": "frozen_before_retrieval"
    },
    "endpoint": {
      "const": "https://www.crystallography.net/cod/result"
    },
    "request_digest_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "input",
        "prefix"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "waajacu-canonical-json-v1"
        },
        "input": {
          "const": "waajacu-canonical-json-v1({headers: transport.headers, method: request.method, url: request.url})"
        },
        "prefix": {
          "const": "sha256:"
        }
      }
    },
    "response_validation": {
      "$ref": "#/$defs/responseValidation"
    },
    "transport": {
      "$ref": "#/$defs/transport"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "requests": {
      "type": "array",
      "minItems": 1000,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "safety_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinals_are_contiguous_zero_through_999",
        "ddd_prefix_is_zero_padded_ordinal",
        "requests_are_in_ordinal_order",
        "every_url_matches_the_frozen_template",
        "request_digests_match_the_frozen_policy",
        "prefixes_form_a_complete_nonoverlapping_partition",
        "raw_response_bytes_are_immutable",
        "candidate_discovery_precedes_normalization",
        "normalized_output_is_forbidden",
        "catalog_and_registry_database_writes_are_forbidden"
      ],
      "properties": {
        "ordinals_are_contiguous_zero_through_999": {
          "const": true
        },
        "ddd_prefix_is_zero_padded_ordinal": {
          "const": true
        },
        "requests_are_in_ordinal_order": {
          "const": true
        },
        "every_url_matches_the_frozen_template": {
          "const": true
        },
        "request_digests_match_the_frozen_policy": {
          "const": true
        },
        "prefixes_form_a_complete_nonoverlapping_partition": {
          "const": true
        },
        "raw_response_bytes_are_immutable": {
          "const": true
        },
        "candidate_discovery_precedes_normalization": {
          "const": true
        },
        "normalized_output_is_forbidden": {
          "const": true
        },
        "catalog_and_registry_database_writes_are_forbidden": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "responseValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "top_level",
        "text_encoding",
        "byte_order_mark",
        "duplicate_object_keys",
        "depth",
        "rows",
        "scalar_policy",
        "file",
        "svnrevision",
        "unknown_row_fields",
        "row_order",
        "record_key",
        "duplicate_record_keys"
      ],
      "properties": {
        "profile": {
          "const": "cod_metadata_json_rows_v1"
        },
        "top_level": {
          "const": "array_of_objects"
        },
        "text_encoding": {
          "const": "utf8"
        },
        "byte_order_mark": {
          "const": "forbidden"
        },
        "duplicate_object_keys": {
          "const": "forbidden"
        },
        "depth": {
          "$ref": "#/$defs/depthValidation"
        },
        "rows": {
          "$ref": "#/$defs/rowValidation"
        },
        "scalar_policy": {
          "const": "decimal_string_or_unsigned_json_integer_v1"
        },
        "file": {
          "$ref": "#/$defs/fileValidation"
        },
        "svnrevision": {
          "$ref": "#/$defs/revisionValidation"
        },
        "unknown_row_fields": {
          "const": "allowed"
        },
        "row_order": {
          "const": "ignored"
        },
        "record_key": {
          "const": "canonical_file_and_numeric_svnrevision"
        },
        "duplicate_record_keys": {
          "const": "identical_rows_allowed_conflicting_rows_block"
        }
      }
    },
    "depthValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_value_depth",
        "maximum"
      ],
      "properties": {
        "root_value_depth": {
          "const": 1
        },
        "maximum": {
          "const": 64
        }
      }
    },
    "rowValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum",
        "enforcement"
      ],
      "properties": {
        "maximum": {
          "const": 10000
        },
        "enforcement": {
          "const": "during_top_level_array_parse"
        }
      }
    },
    "fileValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_form",
        "request_prefix_match"
      ],
      "properties": {
        "canonical_form": {
          "const": "exactly_seven_ascii_digits"
        },
        "request_prefix_match": {
          "const": "first_three_digits"
        }
      }
    },
    "revisionValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum"
      ],
      "properties": {
        "minimum": {
          "const": 1
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "host",
        "port",
        "method",
        "headers",
        "accepted_success_content_types",
        "concurrency",
        "minimum_attempt_start_interval_ms",
        "connect_timeout_ms",
        "attempt_timeout_ms",
        "maximum_attempts_per_request",
        "attempt_backoff_ms",
        "retry_after_cap_ms",
        "retryable_http_statuses",
        "redirects",
        "authentication",
        "cookies",
        "request_body",
        "conditional_requests",
        "jitter"
      ],
      "properties": {
        "scheme": {
          "const": "https"
        },
        "host": {
          "const": "www.crystallography.net"
        },
        "port": {
          "const": 443
        },
        "method": {
          "const": "GET"
        },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Accept",
            "Accept-Encoding",
            "Cache-Control",
            "User-Agent"
          ],
          "properties": {
            "Accept": {
              "const": "application/json"
            },
            "Accept-Encoding": {
              "const": "identity"
            },
            "Cache-Control": {
              "const": "no-cache"
            },
            "User-Agent": {
              "const": "Waajacu-COD-Crystallography-Pilot/1 (+https://waajacu.org/)"
            }
          }
        },
        "accepted_success_content_types": {
          "type": "array",
          "prefixItems": [
            {
              "const": "application/json"
            },
            {
              "const": "text/json"
            },
            {
              "const": "text/plain"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "concurrency": {
          "const": 1
        },
        "minimum_attempt_start_interval_ms": {
          "const": 12000
        },
        "connect_timeout_ms": {
          "const": 15000
        },
        "attempt_timeout_ms": {
          "const": 180000
        },
        "maximum_attempts_per_request": {
          "const": 4
        },
        "attempt_backoff_ms": {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "const": 12000
            },
            {
              "const": 24000
            },
            {
              "const": 48000
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "retry_after_cap_ms": {
          "const": 300000
        },
        "retryable_http_statuses": {
          "type": "array",
          "prefixItems": [
            {
              "const": 408
            },
            {
              "const": 425
            },
            {
              "const": 429
            },
            {
              "const": 500
            },
            {
              "const": 502
            },
            {
              "const": 503
            },
            {
              "const": 504
            }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        },
        "redirects": {
          "const": "forbidden"
        },
        "authentication": {
          "const": "forbidden"
        },
        "cookies": {
          "const": "forbidden"
        },
        "request_body": {
          "const": "forbidden"
        },
        "conditional_requests": {
          "const": "forbidden"
        },
        "jitter": {
          "const": "forbidden"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_requests",
        "maximum_response_header_bytes",
        "maximum_success_response_bytes",
        "maximum_error_response_bytes",
        "maximum_total_raw_response_bytes",
        "maximum_json_depth",
        "maximum_rows_per_shard"
      ],
      "properties": {
        "planned_requests": {
          "const": 1000
        },
        "maximum_response_header_bytes": {
          "const": 65536
        },
        "maximum_success_response_bytes": {
          "const": 134217728
        },
        "maximum_error_response_bytes": {
          "const": 1048576
        },
        "maximum_total_raw_response_bytes": {
          "const": 8589934592
        },
        "maximum_json_depth": {
          "const": 64
        },
        "maximum_rows_per_shard": {
          "const": 10000
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "ddd_prefix",
        "method",
        "url",
        "request_sha256"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "ddd_prefix": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "method": {
          "const": "GET"
        },
        "url": {
          "type": "string",
          "pattern": "^https://www\\.crystallography\\.net/cod/result\\?format=json&id=[0-9]{3}%25&include_duplicates=1&include_errors=1&include_theoretical=1$"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
