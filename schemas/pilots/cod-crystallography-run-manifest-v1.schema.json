{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waajacu.org/schemas/pilots/cod-crystallography-run-manifest-v1.schema.json",
  "title": "Completed private COD crystallography pilot run manifest v1",
  "description": "Content-addressed execution manifest for the 96-mineral private pilot. It is evidence of a run, not authority to stage or publish its claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "pilot_id",
    "run_id",
    "completed_at",
    "contract",
    "questionnaire",
    "source_matrix",
    "selection_manifest",
    "query",
    "raw_artifacts",
    "adapter",
    "crosswalk_artifact",
    "result_artifact",
    "counts",
    "review",
    "staging",
    "public_projection"
  ],
  "properties": {
    "format": {
      "const": "waajacu-cod-crystallography-run-manifest"
    },
    "schema_version": {
      "const": 1
    },
    "pilot_id": {
      "const": "cod-crystallography-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract": {
      "$ref": "#/$defs/artifactBinding"
    },
    "questionnaire": {
      "$ref": "#/$defs/versionedBinding"
    },
    "source_matrix": {
      "$ref": "#/$defs/versionedBinding"
    },
    "selection_manifest": {
      "$ref": "#/$defs/artifactBinding"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor",
        "configuration_sha256",
        "candidate_discovery_frozen_before_normalization"
      ],
      "properties": {
        "descriptor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_discovery_frozen_before_normalization": {
          "const": true
        }
      }
    },
    "raw_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/rawArtifact"
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "implementation_language",
        "version",
        "code_revision",
        "configuration_sha256",
        "development_configuration_frozen_before_holdout"
      ],
      "properties": {
        "policy": {
          "const": "cod_crystallography_v1"
        },
        "implementation_language": {
          "const": "rust"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "code_revision": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "development_configuration_frozen_before_holdout": {
          "const": true
        }
      }
    },
    "crosswalk_artifact": {
      "$ref": "#/$defs/artifactBinding"
    },
    "result_artifact": {
      "$ref": "#/$defs/artifactBinding"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_minerals",
        "development_minerals",
        "holdout_minerals",
        "matched",
        "no_candidate",
        "ambiguous",
        "excluded",
        "source_records",
        "accepted_crosswalks",
        "reviewed_crosswalks",
        "extraction_outcomes",
        "reviewed_extraction_outcomes"
      ],
      "properties": {
        "selected_minerals": {
          "const": 96
        },
        "development_minerals": {
          "const": 72
        },
        "holdout_minerals": {
          "const": 24
        },
        "matched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 96
        },
        "no_candidate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 96
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0,
          "maximum": 96
        },
        "excluded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 96
        },
        "source_records": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_crosswalks": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_crosswalks": {
          "type": "integer",
          "minimum": 0
        },
        "extraction_outcomes": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_extraction_outcomes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_crosswalk_reviewed",
        "every_extraction_outcome_reviewed",
        "holdout_not_used_to_change_adapter",
        "report"
      ],
      "properties": {
        "every_crosswalk_reviewed": {
          "const": true
        },
        "every_extraction_outcome_reviewed": {
          "const": true
        },
        "holdout_not_used_to_change_adapter": {
          "const": true
        },
        "report": {
          "$ref": "#/$defs/artifactBinding"
        }
      }
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "runtime_ingestion_status"
      ],
      "properties": {
        "target": {
          "const": "private_content_addressed_artifacts_only"
        },
        "runtime_ingestion_status": {
          "const": "blocked_until_cod_crystallography_v1_claim_only_path"
        }
      }
    },
    "public_projection": {
      "const": "forbidden"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "versionedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "revision",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "rawArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_url",
        "retrieved_at",
        "sha256",
        "bytes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cod_search_response",
            "revision_pinned_cif"
          ]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
