{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waajacu.org/schemas/pilots/cod-metadata-discovery-execution-index-v3.schema.json",
  "title": "COD execution index v3 with log-evidenced TLS recovery",
  "description": "Extends v2 reviewed transport recovery only for generic request failures proven by an immutable private log to be TLS closure before HTTP response headers. Each reviewed request error must match the exact shard, attempt and URL and the SendRequest/TLS-close error chain. Ordinary connect/timeout recovery remains supported. The eight-shard limit, one extra four-attempt cycle per shard, five-minute cooldown, and immutable failure history remain enforced. Body failures and response validation failures are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "pilot_id",
    "index_revision",
    "status",
    "started_at",
    "updated_at",
    "plan",
    "counts",
    "successful_receipts",
    "safety_assertions",
    "transport_recoveries"
  ],
  "properties": {
    "format": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/format"
    },
    "schema_version": {
      "const": 3
    },
    "pilot_id": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/pilot_id"
    },
    "index_revision": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/index_revision"
    },
    "status": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/status"
    },
    "started_at": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/started_at"
    },
    "updated_at": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/updated_at"
    },
    "completed_at": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/completed_at"
    },
    "plan": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/plan"
    },
    "counts": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/counts"
    },
    "successful_receipts": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/successful_receipts"
    },
    "halted_request": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/halted_request"
    },
    "snapshot_identity": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/snapshot_identity"
    },
    "safety_assertions": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/properties/safety_assertions"
    },
    "transport_recoveries": {
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/transportRecovery"
      },
      "minItems": 1,
      "type": "array",
      "contains": {
        "required": [
          "request_failure_log"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completed_at",
          "snapshot_identity"
        ],
        "properties": {
          "completed_at": {},
          "snapshot_identity": {},
          "counts": {
            "allOf": [
              {
                "$ref": "#/$defs/counts"
              },
              {
                "properties": {
                  "successful_requests": {
                    "const": 1000
                  },
                  "next_ordinal": {
                    "const": 1000
                  }
                }
              }
            ]
          },
          "successful_receipts": {
            "type": "array",
            "minItems": 1000,
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/successfulReceipt"
            }
          }
        },
        "not": {
          "required": [
            "halted_request"
          ]
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "completed_at"
              ]
            },
            {
              "required": [
                "snapshot_identity"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/sha256"
    },
    "planBinding": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/planBinding"
    },
    "counts": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/counts"
    },
    "successfulReceipt": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/successfulReceipt"
    },
    "successfulResponse": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/successfulResponse"
    },
    "attempt": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/attempt"
    },
    "haltedRequest": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/haltedRequest"
    },
    "requestUrl": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/requestUrl"
    },
    "nullableHeaderValue": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/nullableHeaderValue"
    },
    "rawBodyBinding": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/rawBodyBinding"
    },
    "snapshotIdentity": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/snapshotIdentity"
    },
    "safetyAssertions": {
      "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/safetyAssertions"
    },
    "transportRecovery": {
      "oneOf": [
        {
          "$ref": "cod-metadata-discovery-execution-index-v2.schema.json#/$defs/transportRecovery"
        },
        {
          "additionalProperties": false,
          "required": [
            "reviewed_at",
            "reviewer",
            "reason",
            "previous_index",
            "halted_request",
            "request_failure_log"
          ],
          "properties": {
            "halted_request": {
              "allOf": [
                {
                  "$ref": "#/$defs/haltedRequest"
                },
                {
                  "properties": {
                    "attempts": {
                      "maxItems": 4,
                      "items": {
                        "properties": {
                          "outcome": {
                            "const": "transport_error"
                          },
                          "error_kind": {
                            "enum": [
                              "connect",
                              "timeout",
                              "request"
                            ]
                          }
                        }
                      },
                      "minItems": 4,
                      "type": "array",
                      "contains": {
                        "required": [
                          "error_kind"
                        ],
                        "properties": {
                          "error_kind": {
                            "const": "request"
                          }
                        }
                      }
                    },
                    "reason": {
                      "const": "transport_error"
                    }
                  }
                }
              ]
            },
            "reviewed_at": {
              "type": "string",
              "format": "date-time"
            },
            "reviewer": {
              "minLength": 1,
              "maxLength": 120,
              "type": "string"
            },
            "reason": {
              "minLength": 1,
              "maxLength": 2000,
              "type": "string"
            },
            "previous_index": {
              "$ref": "#/$defs/rawBodyBinding"
            },
            "request_failure_log": {
              "$ref": "#/$defs/rawBodyBinding"
            }
          },
          "type": "object"
        }
      ]
    }
  }
}
