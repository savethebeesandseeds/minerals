# Shared, non-secret defaults for local development.
# Keep this file in git so everyone sees the expected variables.

PORT=7979
BIND_ADDRESS=127.0.0.1
DATA_ROOT=data
DEFAULT_LANG=en
COOKIE_SECURE=false
# Local static-catalog origin used by admin navigation. Override with the
# production HTTPS URL, or leave empty when the public catalog is not deployed.
PUBLIC_CATALOG_BASE_URL=http://127.0.0.1:18965
PUBLIC_CATALOG_BIND_ADDRESS=127.0.0.1
PUBLIC_CATALOG_HOST_PORT=18965
# Exact TCP-peer IPs allowed to supply X-Forwarded-For.
# Keep empty unless a trusted reverse proxy connects directly to this service.
TRUSTED_PROXY_IPS=
ADMIN_SQL_ENABLED=false
# Quarantine accounting includes canonical chunk JSON and canonical item copies.
# These are safety limits, not record-capacity claims; invalid values fail startup.
INGESTION_BATCH_MAX_BYTES=67108864
# Global quota covers receiving/ready/needs_attention; terminal payload is compacted.
INGESTION_QUARANTINE_MAX_BYTES=536870912
# Inactive receiving batches are tombstoned after 14 days; no public rows expire.
INGESTION_ABANDONED_HOURS=336
OPENAI_MODEL=gpt-5.2
OPENAI_TRANSLATION_MODEL=gpt-5-nano
